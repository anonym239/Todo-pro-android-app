<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widgetLargeRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_background"
    android:padding="14dp">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="10dp">

        <TextView
            android:id="@+id/widgetLargeTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="TODOPRO"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:fontFamily="sans-serif-black" />

        <TextView
            android:id="@+id/widgetLargeStreak"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="13sp"
            android:textColor="#FFD740"
            android:fontFamily="sans-serif-medium" />

    </LinearLayout>

    <!-- Anzahl offen -->
    <TextView
        android:id="@+id/widgetLargeCount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="12sp"
        android:textColor="#69F0AE"
        android:fontFamily="sans-serif"
        android:layout_marginBottom="10dp" />

    <!-- Trennlinie -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#33FFFFFF"
        android:layout_marginBottom="8dp" />

    <!-- Todo 1 -->
    <LinearLayout
        android:id="@+id/widgetRow1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="5dp"
        android:visibility="gone">
        <TextView android:id="@+id/widgetDot1" android:layout_width="20dp" android:layout_height="wrap_content" android:textSize="10sp" />
        <TextView android:id="@+id/widgetTodo1" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:textSize="12sp" android:textColor="#EEEEEE" android:maxLines="1" android:ellipsize="end" android:fontFamily="sans-serif" />
    </LinearLayout>

    <!-- Todo 2 -->
    <LinearLayout
        android:id="@+id/widgetRow2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="5dp"
        android:visibility="gone">
        <TextView android:id="@+id/widgetDot2" android:layout_width="20dp" android:layout_height="wrap_content" android:textSize="10sp" />
        <TextView android:id="@+id/widgetTodo2" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:textSize="12sp" android:textColor="#EEEEEE" android:maxLines="1" android:ellipsize="end" android:fontFamily="sans-serif" />
    </LinearLayout>

    <!-- Todo 3 -->
    <LinearLayout
        android:id="@+id/widgetRow3"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="5dp"
        android:visibility="gone">
        <TextView android:id="@+id/widgetDot3" android:layout_width="20dp" android:layout_height="wrap_content" android:textSize="10sp" />
        <TextView android:id="@+id/widgetTodo3" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:textSize="12sp" android:textColor="#EEEEEE" android:maxLines="1" android:ellipsize="end" android:fontFamily="sans-serif" />
    </LinearLayout>

    <!-- Todo 4 -->
    <LinearLayout
        android:id="@+id/widgetRow4"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="5dp"
        android:visibility="gone">
        <TextView android:id="@+id/widgetDot4" android:layout_width="20dp" android:layout_height="wrap_content" android:textSize="10sp" />
        <TextView android:id="@+id/widgetTodo4" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:textSize="12sp" android:textColor="#EEEEEE" android:maxLines="1" android:ellipsize="end" android:fontFamily="sans-serif" />
    </LinearLayout>

    <!-- Todo 5 -->
    <LinearLayout
        android:id="@+id/widgetRow5"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="5dp"
        android:visibility="gone">
        <TextView android:id="@+id/widgetDot5" android:layout_width="20dp" android:layout_height="wrap_content" android:textSize="10sp" />
        <TextView android:id="@+id/widgetTodo5" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:textSize="12sp" android:textColor="#EEEEEE" android:maxLines="1" android:ellipsize="end" android:fontFamily="sans-serif" />
    </LinearLayout>

    <!-- Mehr -->
    <TextView
        android:id="@+id/widgetMoreCount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="11sp"
        android:textColor="#888888"
        android:fontFamily="sans-serif"
        android:visibility="gone" />

</LinearLayout>
