<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:paddingHorizontal="32dp"
    android:paddingBottom="16dp"
    android:paddingTop="48dp">

    <!-- Big Emoji Icon -->
    <TextView
        android:id="@+id/tvPageIcon"
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:textSize="64sp"
        android:gravity="center"
        android:background="@drawable/onboarding_highlight_bg"
        android:layout_marginBottom="36dp" />

    <!-- Title -->
    <TextView
        android:id="@+id/tvPageTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="28sp"
        android:textColor="#FFFFFF"
        android:textStyle="bold"
        android:fontFamily="sans-serif-black"
        android:gravity="center"
        android:lineSpacingMultiplier="1.15"
        android:layout_marginBottom="18dp" />

    <!-- Description -->
    <TextView
        android:id="@+id/tvPageDesc"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="16sp"
        android:textColor="#9AA0C0"
        android:fontFamily="sans-serif"
        android:gravity="center"
        android:lineSpacingMultiplier="1.6"
        android:layout_marginBottom="28dp" />

    <!-- Highlight tip box -->
    <LinearLayout
        android:id="@+id/highlightBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/onboarding_highlight_bg"
        android:paddingHorizontal="16dp"
        android:paddingVertical="14dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/tvHighlightIcon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="22sp"
            android:layout_marginEnd="12dp" />

        <TextView
            android:id="@+id/tvHighlightText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textSize="13sp"
            android:textColor="@color/neon_yellow"
            android:fontFamily="sans-serif"
            android:lineSpacingMultiplier="1.4" />

    </LinearLayout>

</LinearLayout>
