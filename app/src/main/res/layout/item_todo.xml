<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/todoItemRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp">

    <!-- Card wrapper with rounded corners -->
    <LinearLayout
        android:id="@+id/cardContent"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/todo_item_bg"
        android:clipToOutline="true"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Roter Prioritäts-Streifen (links, innerhalb der Karte) -->
        <View
            android:id="@+id/priorityBar"
            android:layout_width="5dp"
            android:layout_height="match_parent"
            android:background="#FF4444"
            android:visibility="gone" />

        <!-- Kategorie-Streifen (farbig, links) -->
        <View
            android:id="@+id/categoryBar"
            android:layout_width="5dp"
            android:layout_height="match_parent"
            android:background="@color/neon_blue"
            android:visibility="gone" />

        <!-- Inhalt der Karte -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="14dp"
            android:paddingEnd="10dp"
            android:paddingVertical="10dp">

            <!-- Kategorie-Badge (oben) -->
            <TextView
                android:id="@+id/tvCategoryBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="10sp"
                android:textColor="#AAAAAA"
                android:fontFamily="sans-serif"
                android:visibility="gone"
                android:layout_marginBottom="4dp" />

            <!-- Text + Buttons Zeile -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <!-- Text + reminder time -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <EditText
                        android:id="@+id/editTodoText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="?attr/todoTextColor"
                        android:textSize="15sp"
                        android:fontFamily="sans-serif"
                        android:background="@null"
                        android:padding="0dp"
                        android:singleLine="false"
                        android:maxLines="3"
                        android:inputType="textMultiLine|textCapSentences" />

                    <TextView
                        android:id="@+id/tvReminderTime"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="11sp"
                        android:textColor="@color/neon_yellow"
                        android:fontFamily="sans-serif"
                        android:visibility="gone"
                        android:layout_marginTop="2dp" />

                    <!-- Erinnerungsvorschlag -->
                    <TextView
                        android:id="@+id/tvReminderSuggestion"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="11sp"
                        android:textColor="@color/neon_green"
                        android:fontFamily="sans-serif"
                        android:visibility="gone"
                        android:layout_marginTop="3dp"
                        android:drawablePadding="4dp" />

                </LinearLayout>

                <!-- Reminder bell button -->
                <ImageButton
                    android:id="@+id/btnReminder"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="@null"
                    android:src="@drawable/ic_bell"
                    android:contentDescription="Erinnerung setzen"
                    android:padding="6dp"
                    android:layout_marginEnd="4dp" />

                <!-- Complete button + date below -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center_horizontal"
                    android:layout_marginStart="4dp">

                    <ImageButton
                        android:id="@+id/btnComplete"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="@drawable/btn_complete_bg"
                        android:src="@drawable/ic_check"
                        android:contentDescription="Aufgabe abschließen"
                        android:padding="8dp" />

                    <TextView
                        android:id="@+id/tvCreatedDate"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="9sp"
                        android:textColor="?attr/todoHintColor"
                        android:fontFamily="sans-serif"
                        android:gravity="center"
                        android:layout_marginTop="2dp" />

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
