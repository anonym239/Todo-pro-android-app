<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/todoItemRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp">

    <LinearLayout
        android:id="@+id/cardContent"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/todo_item_bg"
        android:clipToOutline="true"
        android:elevation="2dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <View
            android:id="@+id/priorityBar"
            android:layout_width="5dp"
            android:layout_height="match_parent"
            android:background="@color/priority_red"
            android:visibility="gone" />

        <View
            android:id="@+id/categoryBar"
            android:layout_width="5dp"
            android:layout_height="match_parent"
            android:background="@color/neon_blue"
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="8dp"
            android:paddingTop="12dp"
            android:paddingBottom="12dp">

            <LinearLayout
                android:id="@+id/categoryBadgeRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="6dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/tvCategoryBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="11sp"
                    android:textColor="?attr/todoTextSecondary"
                    android:fontFamily="sans-serif-medium"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="2dp"
                    android:background="@drawable/chip_bg" />

                <View android:layout_width="0dp" android:layout_height="0dp" android:layout_weight="1"/>

                <TextView
                    android:id="@+id/tvSubtaskCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="10sp"
                    android:textColor="?attr/todoTextSecondary"
                    android:fontFamily="sans-serif"
                    android:visibility="gone" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <EditText
                        android:id="@+id/editTodoText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="?attr/todoTextColor"
                        android:textSize="15sp"
                        android:fontFamily="sans-serif"
                        android:lineSpacingMultiplier="1.3"
                        android:background="@null"
                        android:padding="0dp"
                        android:singleLine="false"
                        android:maxLines="4"
                        android:inputType="textMultiLine|textCapSentences" />

                    <TextView
                        android:id="@+id/tvReminderTime"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="11sp"
                        android:textColor="@color/neon_yellow"
                        android:fontFamily="sans-serif-medium"
                        android:visibility="gone"
                        android:layout_marginTop="5dp" />

                    <TextView
                        android:id="@+id/tvReminderSuggestion"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="11sp"
                        android:textColor="@color/neon_green"
                        android:fontFamily="sans-serif"
                        android:visibility="gone"
                        android:layout_marginTop="4dp" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center_horizontal"
                    android:layout_marginStart="8dp">

                    <ImageButton
                        android:id="@+id/btnReminder"
                        android:layout_width="34dp"
                        android:layout_height="34dp"
                        android:background="@null"
                        android:src="@drawable/ic_bell"
                        android:contentDescription="Erinnerung setzen"
                        android:padding="5dp"
                        android:alpha="0.5"
                        android:layout_marginBottom="4dp" />

                    <ImageButton
                        android:id="@+id/btnComplete"
                        android:layout_width="42dp"
                        android:layout_height="42dp"
                        android:background="@drawable/btn_complete_bg"
                        android:src="@drawable/ic_check"
                        android:contentDescription="Aufgabe abschließen"
                        android:padding="9dp" />

                    <TextView
                        android:id="@+id/tvCreatedDate"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="9sp"
                        android:textColor="?attr/todoHintColor"
                        android:fontFamily="sans-serif"
                        android:gravity="center"
                        android:layout_marginTop="3dp" />

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
