<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@drawable/todo_item_bg"
    android:layout_marginBottom="10dp"
    android:paddingHorizontal="16dp"
    android:paddingVertical="14dp">

    <!-- Grüner Streifen links (erledigt) -->
    <View
        android:layout_width="4dp"
        android:layout_height="match_parent"
        android:background="@color/neon_green"
        android:layout_marginEnd="12dp" />

    <!-- Text + Datum + Kategorie -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvArchivedText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="15sp"
            android:textColor="?attr/todoTextColor"
            android:fontFamily="sans-serif"
            android:maxLines="2"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/tvArchivedDate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="11sp"
            android:textColor="@color/neon_green"
            android:fontFamily="sans-serif"
            android:layout_marginTop="3dp" />

        <TextView
            android:id="@+id/tvArchivedCategory"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="10sp"
            android:textColor="#AAAAAA"
            android:fontFamily="sans-serif"
            android:visibility="gone"
            android:layout_marginTop="2dp" />

    </LinearLayout>

    <!-- Wiederherstellen Button -->
    <ImageButton
        android:id="@+id/btnRestore"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="@drawable/btn_icon_bg"
        android:src="@drawable/ic_restore"
        android:contentDescription="Wiederherstellen"
        android:padding="8dp"
        android:layout_marginStart="8dp" />

</LinearLayout>
