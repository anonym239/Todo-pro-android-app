<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/todoBgColor">

    <!-- Header -->
    <LinearLayout
        android:id="@+id/header"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="20dp"
        android:paddingBottom="14dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Logo: TODO weiß, PRO neon-gelb -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="TODO"
                android:textSize="26sp"
                android:fontFamily="sans-serif-black"
                android:textStyle="bold"
                android:textColor="?attr/todoTextColor"
                android:letterSpacing="0.05" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="PRO"
                android:textSize="26sp"
                android:fontFamily="sans-serif-black"
                android:textStyle="bold"
                android:textColor="@color/neon_yellow"
                android:letterSpacing="0.05" />

        </LinearLayout>

        <!-- Theme Toggle Button -->
        <ImageButton
            android:id="@+id/btnTheme"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:background="@drawable/btn_icon_bg"
            android:src="@drawable/ic_theme"
            android:contentDescription="Theme wechseln"
            android:padding="11dp"
            android:layout_marginEnd="8dp" />

        <!-- Notifications Button -->
        <ImageButton
            android:id="@+id/btnNotifications"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:background="@drawable/btn_icon_bg"
            android:src="@drawable/ic_bell"
            android:contentDescription="Benachrichtigungen"
            android:padding="11dp"
            android:layout_marginEnd="8dp" />

        <!-- Help Button -->
        <ImageButton
            android:id="@+id/btnHelp"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:background="@drawable/btn_icon_bg"
            android:src="@drawable/ic_book"
            android:contentDescription="Hilfe"
            android:padding="11dp" />

    </LinearLayout>

    <!-- Divider -->
    <View
        android:id="@+id/divider"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:background="?attr/todoDividerColor"
        app:layout_constraintTop_toBottomOf="@id/header"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Input Row -->
    <LinearLayout
        android:id="@+id/inputRow"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingTop="16dp"
        android:paddingBottom="10dp"
        android:gravity="center_vertical"
        app:layout_constraintTop_toBottomOf="@id/divider"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <EditText
            android:id="@+id/editInput"
            android:layout_width="0dp"
            android:layout_height="54dp"
            android:layout_weight="1"
            android:hint="Was steht an?"
            android:textColorHint="?attr/todoHintColor"
            android:textColor="?attr/todoTextColor"
            android:textSize="16sp"
            android:fontFamily="sans-serif"
            android:background="@drawable/input_bg"
            android:paddingHorizontal="18dp"
            android:imeOptions="actionDone"
            android:inputType="text"
            android:singleLine="true"
            android:layout_marginEnd="10dp" />

        <ImageButton
            android:id="@+id/btnAdd"
            android:layout_width="54dp"
            android:layout_height="54dp"
            android:background="@drawable/btn_add_bg"
            android:src="@drawable/ic_plus"
            android:contentDescription="Aufgabe hinzufügen"
            android:padding="14dp" />

    </LinearLayout>

    <!-- Empty State -->
    <LinearLayout
        android:id="@+id/emptyView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:orientation="vertical"
        android:gravity="center"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/inputRow"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/emptyIcon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="✦"
            android:textSize="44sp"
            android:textColor="?attr/todoTextColor"
            android:layout_marginBottom="20dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Alles frei. Was kommt als nächstes?"
            android:textSize="18sp"
            android:textColor="?attr/todoEmptyTitleColor"
            android:textStyle="bold"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:paddingHorizontal="32dp"
            android:layout_marginBottom="10dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Gib eine Aufgabe oben ein."
            android:textSize="14sp"
            android:textColor="?attr/todoHintColor"
            android:gravity="center" />

    </LinearLayout>

    <!-- RecyclerView -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:paddingHorizontal="16dp"
        android:paddingTop="4dp"
        android:paddingBottom="80dp"
        android:clipToPadding="false"
        app:layout_constraintTop_toBottomOf="@id/inputRow"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Konfetti View -->
    <nl.dionsegijn.konfetti.xml.KonfettiView
        android:id="@+id/konfettiView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Snackbar -->
    <LinearLayout
        android:id="@+id/snackbarLayout"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:background="@drawable/snackbar_bg"
        android:paddingHorizontal="20dp"
        android:paddingVertical="14dp"
        android:visibility="gone"
        android:layout_marginHorizontal="16dp"
        android:layout_marginBottom="24dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/tvSnackbar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:fontFamily="sans-serif"
            android:gravity="center" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
